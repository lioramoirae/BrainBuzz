<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- App Title -->
        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="🧠 BrainBuzz"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#2196F3"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Choose your learning style"
            android:textSize="16sp"
            android:gravity="center"
            android:textColor="#666666"
            app:layout_constraintTop_toBottomOf="@id/tv_app_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

        <!-- User Type Cards -->
        <LinearLayout
            android:id="@+id/card_casual"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginTop="32dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/tv_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎮 Casual User"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Play quick quizzes during free time"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:textColor="#666666" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Guest mode available\n• Basic tracking\n• Simple interface"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:textColor="#888888" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_student"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/card_casual"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📚 Student"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Practice general knowledge for learning"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:textColor="#666666" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Progress by subject\n• Study mode\n• Detailed analytics"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:textColor="#888888" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_competitive"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/card_student"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏆 Competitive User"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Track scores and challenge friends"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:textColor="#666666" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Leaderboards\n• Challenges\n• Advanced stats"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:textColor="#888888" />

        </LinearLayout>

        <!-- Selection Info -->
        <TextView
            android:id="@+id/tv_selected_type"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Selected: Casual User"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:textColor="#2196F3"
            app:layout_constraintTop_toBottomOf="@id/card_competitive"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_type_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Play quick quizzes during free time"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:textColor="#666666"
            app:layout_constraintTop_toBottomOf="@id/tv_selected_type"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btn_continue_guest"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Continue as Guest"
            android:textSize="16sp"
            android:layout_marginTop="32dp"
            android:backgroundTint="#4CAF50"
            app:layout_constraintTop_toBottomOf="@id/tv_type_description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btn_signup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Sign Up as Casual User"
            android:textSize="16sp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#2196F3"
            app:layout_constraintTop_toBottomOf="@id/btn_continue_guest"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btn_login"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Already have an account? Login"
            android:textSize="14sp"
            android:layout_marginTop="12dp"
            style="@style/Widget.Material3.Button.TextButton"
            app:layout_constraintTop_toBottomOf="@id/btn_signup"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
