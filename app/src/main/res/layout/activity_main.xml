<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Welcome Header -->
        <TextView
            android:id="@+id/tv_welcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🧠 Welcome to BrainBuzz!"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#2196F3"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <!-- User Info -->
        <TextView
            android:id="@+id/tv_user_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hello, User!"
            android:textSize="18sp"
            android:gravity="center"
            android:textColor="#666666"
            android:layout_marginBottom="4dp" />

        <!-- User Type -->
        <TextView
            android:id="@+id/tv_user_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Casual"
            android:textSize="16sp"
            android:gravity="center"
            android:textColor="#888888"
            android:layout_marginBottom="24dp" />

        <!-- Stats Card -->
        <LinearLayout
            android:id="@+id/stats_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:elevation="4dp"
            android:padding="24dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_user_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Score: 0 | Quizzes: 0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="#2196F3"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_progress_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Take your first quiz to see your progress!"
                android:textSize="16sp"
                android:gravity="center"
                android:textColor="#666666" />

        </LinearLayout>

        <!-- Guest Message (only visible for guests) -->
        <TextView
            android:id="@+id/tv_guest_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎮 You're in Guest Mode!\nSign up to save your progress and unlock more features!"
            android:textSize="14sp"
            android:gravity="center"
            android:textColor="#FF9800"
            android:background="#FFF3E0"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- Guest Action Buttons (only visible for guests) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_guest_signup"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="🚀 Sign Up"
                android:textSize="14sp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_guest_features"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="ℹ️ Guest Info"
                android:textSize="14sp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#2196F3"
                android:textColor="#FFFFFF"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Main Action Button -->
        <Button
            android:id="@+id/btn_start_quiz"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="🚀 Start Quiz"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF" />

        <!-- Secondary Buttons Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <!-- First Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btn_categories"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:text="📚 Categories"
                    android:textSize="16sp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#2196F3"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btn_history"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:text="📊 History"
                    android:textSize="16sp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#FF9800"
                    android:textColor="#FFFFFF" />

            </LinearLayout>

            <!-- Second Row -->
            <Button
                android:id="@+id/btn_settings"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="⚙️ Settings"
                android:textSize="16sp"
                android:backgroundTint="#9C27B0"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <!-- Footer Space -->
        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

    </LinearLayout>

</ScrollView>